{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    // DOM statt @cloudflare/workers-types: Der Worker benutzt nur Web-Standards
    // (fetch, Request, Response, URL, AbortSignal), die hier alle enthalten sind.
    // Das spart eine Abhaengigkeit und genuegt fuer die Typpruefung.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["worker"]
}
